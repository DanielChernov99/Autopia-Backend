NODE_ENV=development
PORT=3000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/autopia?retryWrites=true&w=majority
JWT_SECRET=<generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))">
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_MODEL=<your-gemini-model>
GEMINI_FALLBACK_MODEL=<optional-fallback-gemini-model>
GEMINI_TIMEOUT_MS=30000
